node_modules/

# Root dist/ holds the prebuilt Windows installer stub, which IS tracked.
# Per-app build output (apps/api/dist) is not.
dist/*
!dist/windows-installer.exe
apps/*/dist/

# Quick Connect caches the RustDesk binary here at first download.
cache/
.next/
*.env
*.env.local
.env.*
!.env.example
prisma/migrations/dev.db
*.db
*.db-journal
*.log
*.bak
.env
.DS_Store
*.tsbuildinfo
/tmp/
src-tauri/target/
apps/web/public/docs-img/

# ── Capture media ────────────────────────────────────────────────────────
# Walkthrough recordings and their MP4/poster renders. These are large
# binaries and do not belong in normal Git history — publish the finished
# files as GitHub release assets and link to them. media/raw/ additionally
# holds unsanitised source recordings and must never be committed.
#
# Root-anchored on purpose: a bare `media/` also matches docs/media/, which
# holds the walkthrough transcript and caption files that DO belong in Git.
/media/

# Playwright leftovers from a capture run: browser state (which carries a
# session cookie), traces, and any stray recording written outside media/.
playwright-report/
test-results/
storage-state*.json
*.webm
