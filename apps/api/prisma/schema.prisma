generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

enum MfaMethodType {
  TOTP
  RECOVERY_CODE
  WEBAUTHN
}

// The Rem0te authorization model has exactly three levels:
//
//   PLATFORM_ADMIN   the Rem0te operator — full access to every business
//   BUSINESS_OWNER   full administrative rights inside ONE business
//   BUSINESS_USER    only the capabilities the Business Owner grants
//                    (see Membership.capabilities)
//
// The values below BUSINESS_USER are legacy. Postgres cannot drop an enum
// value that historical rows may still reference, so they are retained as
// read-only tombstones. Migration 0008 remapped every Membership off them;
// nothing in the application assigns them any more.
enum RoleType {
  PLATFORM_ADMIN
  BUSINESS_OWNER
  BUSINESS_USER

  // ─ legacy, never assigned ─
  TENANT_OWNER
  TENANT_ADMIN
  TECHNICIAN
  BILLING_ADMIN
  READ_ONLY
  CUSTOMER
}

enum EndpointStatus {
  ACTIVE
  OFFLINE
  ARCHIVED
  PENDING_ENROLLMENT
}

enum EnrollmentStatus {
  PENDING
  CLAIMED
  ACTIVE
  REVOKED
}

enum SessionStatus {
  PENDING
  LAUNCH_REQUESTED
  LAUNCHER_ACKNOWLEDGED
  CLIENT_OPENED
  SESSION_STARTED
  SESSION_COMPLETED
  FAILED
  CANCELED
}

enum NoteVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
}

enum ActivityAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  MFA_ENROLLED
  MFA_RESET
  MFA_VERIFIED
  RECOVERY_CODE_USED
  PASSWORD_CHANGED
  USER_CREATED
  USER_UPDATED
  USER_SUSPENDED
  USER_DELETED
  USER_INVITED
  ROLE_ASSIGNED
  ROLE_REVOKED
  ROLE_CHANGED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  SITE_CREATED
  SITE_UPDATED
  SITE_DELETED
  ENDPOINT_CREATED
  ENDPOINT_UPDATED
  ENDPOINT_ARCHIVED
  ENDPOINT_CLAIMED
  ENDPOINT_ENROLLED
  ENDPOINT_UNASSIGNED
  ENDPOINT_ACCESS_GRANTED
  ENDPOINT_ACCESS_REVOKED
  ENDPOINT_CREDENTIAL_ROTATION_STAGED
  ENDPOINT_CREDENTIAL_ROTATED
  ENDPOINT_HEARTBEAT_REJECTED
  CONNECTION_GRANT_CREATED
  CONNECTION_GRANT_REDEEMED
  CONNECTION_GRANT_DENIED
  SESSION_LAUNCHED
  SESSION_COMPLETED
  SESSION_CANCELED
  LAUNCHER_TOKEN_ISSUED
  LAUNCHER_TOKEN_USED
  NOTE_CREATED
  NOTE_UPDATED
  NOTE_DELETED
  NOTE_COMMENT_ADDED
  ENDPOINT_PASSWORD_REVEALED
  RECOVERY_CODE_BLOCKED
  RECOVERY_CODE_LOCKOUT
  BRANDING_UPDATED
  SETTINGS_UPDATED
  API_KEY_CREATED
  API_KEY_REVOKED
  TENANT_CREATED
  TENANT_UPDATED
  CLAIM_TOKEN_CREATED
  INVITATION_SENT
  BUSINESS_CREATED
  BUSINESS_UPDATED
  BUSINESS_DISABLED
  BUSINESS_DELETED
  USER_CAPABILITIES_UPDATED
  PLATFORM_SETTINGS_UPDATED
  QUICK_CONNECT_INITIATED
  QUICK_CONNECT_ENDED
  QUICK_CONNECT_DENIED
  QUICK_CONNECT_SETTING_CHANGED
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings          TenantSettings?
  branding          TenantBranding?
  memberships       Membership[]
  customers         Customer[]
  endpoints         Endpoint[]
  endpointGroups    EndpointGroup[]
  apiKeys           ApiKey[]
  invitations       Invitation[]
  savedViews        SavedView[]
  policies          TenantPolicy[]
  activityLogs      ActivityLog[]
  rustdeskNodes     RustdeskNode[]
  roles             Role[]
  deviceClaimTokens DeviceClaimToken[]
  launcherTokens    LauncherToken[]
  supportSessions   SupportSession[]
  computerAccess    ComputerAccess[]
  connectionGrants  ConnectionGrant[]

  @@index([slug])
}

model TenantSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  requireMfa             Boolean @default(false)
  allowPasswordReset     Boolean @default(true)
  sessionTimeoutMinutes  Int     @default(480)
  maxSessionsPerUser     Int     @default(5)
  passwordMinLength      Int     @default(12)
  passwordRequireMixed   Boolean @default(true)
  passwordRequireSpecial Boolean @default(true)

  rustdeskRelayHost String?
  rustdeskRelayPort Int?
  rustdeskPublicKey String?

  showDownloadPage    Boolean @default(true)
  allowCustomerPortal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantBranding {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  portalTitle  String  @default("Remote Support Portal")
  logoUrl      String?
  faviconUrl   String?
  accentColor  String  @default("#3B82F6")
  supportEmail String?
  supportPhone String?
  footerText   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  isPlatformAdmin Boolean    @default(false)

  // Contact and address information (all optional)
  phone      String?
  jobTitle   String?
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  timeZone   String?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  mfaMethods        UserMfaMethod[]
  memberships       Membership[]
  activityLogs      ActivityLog[]
  notes             Note[]
  noteComments      NoteComment[]
  technicianDevices TechnicianDevice[]
  launcherTokens    LauncherToken[]
  supportSessions   SupportSession[]
  invitationsSent   Invitation[]
  computerAccess    ComputerAccess[]
  connectionGrants  ConnectionGrant[]

  @@index([email])
}

model UserMfaMethod {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     MfaMethodType
  isActive Boolean       @default(true)

  totpSecret   String?
  codeHash     String?
  usedAt       DateTime?
  credentialId String?
  publicKey    Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
}

// ─── RBAC ─────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  type        RoleType
  description String?
  isSystem    Boolean  @default(false)

  memberships     Membership[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String @id @default(cuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// A Membership binds a user to exactly one Business (Customer).
//
//   customerId  IS the business id — it is the security boundary. Every
//               business-scoped query derives its filter from this column.
//               A BUSINESS_OWNER / BUSINESS_USER with a null customerId has
//               no business context and is denied all business-scoped routes.
//   capabilities  granted capability strings, meaningful only for
//                 BUSINESS_USER. BUSINESS_OWNER implicitly holds every
//                 business capability; PLATFORM_ADMIN holds everything.
//                 See src/rbac/capabilities.ts for the vocabulary.
model Membership {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id])
  isActive   Boolean   @default(true)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  capabilities String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

// ─── Customers & Sites ────────────────────────────────────────────────────────

// ─── Business ─────────────────────────────────────────────────────────────────
//
// A Business is a customer organisation created and managed by the Rem0te
// platform operator. It owns its users, its computers, its sessions and its
// audit trail, and it is the ONLY security boundary below Platform Admin.
//
// The table is still named `Customer` so no table rename / FK churn was
// needed; the domain, API and UI all call it a Business.
model Customer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  code       String?
  domain     String?
  email      String?
  phone      String?
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  notes      String?
  isActive   Boolean @default(true)
  isArchived Boolean @default(false)

  sites        Site[]
  endpoints    Endpoint[]
  noteRels     Note[]
  portalUsers  Membership[]

  portalEnabled Boolean @default(false)

  // Per-business Quick Connect switch. Gated by the platform master switch
  // (PlatformSettings.quickConnectEnabled) — OFF at platform level wins.
  quickConnectEnabled Boolean @default(true)

  activityLogs    ActivityLog[]
  supportSessions SupportSession[]
  apiKeys         ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, name])
}

model Site {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name         String
  address      String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  timezone     String?
  notes        String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  isActive     Boolean @default(true)

  endpoints Endpoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([tenantId])
}

// ─── Endpoints ────────────────────────────────────────────────────────────────

model Endpoint {
  id              String         @id @default(cuid())
  tenantId        String?
  tenant          Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id])
  siteId          String?
  site            Site?          @relation(fields: [siteId], references: [id])
  endpointGroupId String?
  endpointGroup   EndpointGroup? @relation(fields: [endpointGroupId], references: [id])

  name         String
  description  String?
  status       EndpointStatus @default(PENDING_ENROLLMENT)
  hostname     String?
  platform     String?
  osVersion    String?
  ipAddress    String?
  macAddress   String?
  serialNumber String?

  isManaged  Boolean   @default(false)
  isOnline   Boolean   @default(false)
  lastSeenAt DateTime?

  rustdeskNode      RustdeskNode?
  enrollment        EndpointEnrollment?
  aliases           EndpointAlias[]
  tags              EndpointTag[]
  noteRels          Note[]
  supportSessions   SupportSession[]
  deviceClaimTokens DeviceClaimToken[]
  computerAccess    ComputerAccess[]
  connectionGrants  ConnectionGrant[]

  // Access mode: how the computer's remote-access authorization is scoped.
  //   ASSIGNED_USERS  → only users listed in ComputerAccess may connect
  //   COMPANY_WIDE    → any user in the same customer may connect (still subject to RBAC/GeoIP)
  accessMode  EndpointAccessMode @default(ASSIGNED_USERS)

  aiTimeline String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([tenantId, status])
}

// Which users have been granted remote access to which computers.
// This is the primary authorization table for "John can connect to JOHN-OFFICE-PC".
// Multi-tenant safe: (userId, endpointId) is unique.
model ComputerAccess {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  grantedBy String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([userId, endpointId])
  @@index([tenantId])
  @@index([endpointId])
  @@index([userId])
}

enum EndpointAccessMode {
  ASSIGNED_USERS
  COMPANY_WIDE
}

model EndpointGroup {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?

  endpoints Endpoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model EndpointTag {
  id         String   @id @default(cuid())
  endpointId String
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  tag        String

  @@unique([endpointId, tag])
  @@index([tag])
}

model EndpointAlias {
  id         String   @id @default(cuid())
  endpointId String
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  alias      String
  isPrimary  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@unique([endpointId, alias])
  @@index([alias])
}

model RustdeskNode {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpointId String   @unique
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  rustdeskId        String    @unique
  lastSeenAt        DateTime?
  platform          String?
  version           String?
  hostname          String?
  publicKey         String?
  permanentPassword String?   // AES-256-GCM encrypted, same format as TOTP secrets

  // SHA-256 of the agent's device secret. The heartbeat used to identify a
  // machine by its RustDesk ID alone — a number printed in the RustDesk window
  // and shared with every technician who has ever connected — so anyone who
  // knew one could collect a pending credential rotation in plaintext,
  // overwrite the stored password, and rewrite the machine's metadata, all
  // unauthenticated. The installer now generates a secret per device, sends it
  // on every call, and the server binds it on first sight (or at claim time).
  // Null means a machine enrolled before this existed: it still reports online,
  // but nothing is written from its heartbeat and no rotation is handed to it
  // until its installer is re-run.
  agentSecretHash   String?
  agentSecretSetAt  DateTime?

  // Credential rotation staging. When the server issues a rotation:
  //   pendingPassword   = AES-GCM(new candidate)
  //   pendingPasswordAt = time it was staged
  // The endpoint's next heartbeat response includes the plaintext new
  // password; the endpoint applies it via rustdesk.exe --password and
  // POSTs to /enrollment/confirm-rotation. Only then does the server
  // swap pending -> permanent and clear pending. This coordinated
  // protocol prevents desync (the old password stays valid until the
  // endpoint confirms).
  pendingPassword   String?
  pendingPasswordAt DateTime?

  // RustDesk client update staging, same shape as the rotation protocol above.
  // The server records a request; the endpoint's next heartbeat response
  // carries the target version; the endpoint re-runs the installer (which is
  // idempotent and pins the version the server serves). The request clears
  // when the endpoint reports `version` matching the target, so a failed
  // update retries on the next heartbeat instead of being lost.
  updateRequestedAt   DateTime?
  updateTargetVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rustdeskId])
}

// A ConnectionGrant is the short-lived authorization the browser hands to
// the launcher instead of the RustDesk password. Ideally the browser only
// receives `{ token, launchUri }`; the launcher then POSTs to /grants/redeem
// with the token to get the actual credentials over authenticated HTTPS.
//
// Single-use; TTL ~60 s; server-issued only after all authorization
// (ComputerAccess / MFA / GeoIP / active user / active company) checks pass.
model ConnectionGrant {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  usedByIp  String?
  createdByIp String?
  purpose   String    @default("REMOTE_ACCESS")

  @@index([tenantId])
  @@index([endpointId])
  @@index([userId])
  @@index([expiresAt])
}

model DeviceClaimToken {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpointId String?
  endpoint   Endpoint? @relation(fields: [endpointId], references: [id])

  token        String    @unique
  expiresAt    DateTime
  claimedAt    DateTime?
  claimedByIp  String?

  customerName String?
  siteName     String?
  description  String?

  // Managed-computer enrollment binding — set by the admin at token-mint time.
  // The endpoint that redeems this token cannot influence any of these values;
  // enrollment.service copies them onto the created endpoint + ComputerAccess.
  customerId       String?
  accessMode       EndpointAccessMode @default(ASSIGNED_USERS)
  assignedUserIds  String[]            @default([])  // whitelisted user IDs (all must belong to the same customer)
  endpointGroupId  String?

  createdAt DateTime @default(now())
  createdById String?

  @@index([token])
  @@index([tenantId])
}

model EndpointEnrollment {
  id         String           @id @default(cuid())
  endpointId String           @unique
  endpoint   Endpoint         @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(PENDING)

  enrolledAt          DateTime?
  revokedAt           DateTime?
  revokedBy           String?
  enrollmentIp        String?
  enrollmentUserAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Technician Devices & Launcher ───────────────────────────────────────────

model TechnicianDevice {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  platform    String
  fingerprint String  @unique
  isActive    Boolean @default(true)
  lastSeenAt  DateTime?

  launcherTokens LauncherToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model LauncherToken {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  technicianDeviceId String?
  technicianDevice   TechnicianDevice? @relation(fields: [technicianDeviceId], references: [id])
  supportSessionId   String?           @unique
  supportSession     SupportSession?   @relation(fields: [supportSessionId], references: [id])

  token            String    @unique
  expiresAt        DateTime
  usedAt           DateTime?
  revokedAt        DateTime?
  targetEndpointId String?
  targetRustdeskId String?
  targetAlias      String?

  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ─── Support Sessions ─────────────────────────────────────────────────────────

model SupportSession {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Business that owns this session. Set from the endpoint's business for
  // managed sessions and from the initiating user's business for Quick
  // Connect. Null only for legacy rows whose business could not be derived.
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  technicianId String
  technician   User      @relation(fields: [technicianId], references: [id])
  endpointId   String?
  endpoint     Endpoint? @relation(fields: [endpointId], references: [id])

  contactName      String?
  contactEmail     String?
  isAdHoc          Boolean @default(false)
  adHocRustdeskId  String?
  issueDescription String?

  status      SessionStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?

  notes       String?
  disposition String?

  events        SupportSessionEvent[]
  launcherToken LauncherToken?
  noteRels      Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([technicianId])
  @@index([endpointId])
  @@index([status])
  @@index([customerId, createdAt])
  @@index([tenantId, createdAt])
}

model SupportSessionEvent {
  id               String         @id @default(cuid())
  supportSessionId String
  supportSession   SupportSession @relation(fields: [supportSessionId], references: [id], onDelete: Cascade)

  event     String
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([supportSessionId])
}

// ─── Notes ────────────────────────────────────────────────────────────────────

model Note {
  id       String         @id @default(cuid())
  tenantId String
  authorId String
  author   User           @relation(fields: [authorId], references: [id])

  endpointId String?
  endpoint   Endpoint?       @relation(fields: [endpointId], references: [id])
  customerId String?
  customer   Customer?       @relation(fields: [customerId], references: [id])
  sessionId  String?
  session    SupportSession? @relation(fields: [sessionId], references: [id])

  content    String
  visibility NoteVisibility @default(INTERNAL)
  isPinned   Boolean        @default(false)

  comments NoteComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endpointId])
  @@index([customerId])
  @@index([tenantId])
}

model NoteComment {
  id       String @id @default(cuid())
  noteId   String
  note     Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  content  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
}

// ─── Activity Log ─────────────────────────────────────────────────────────────

model ActivityLog {
  id         String          @id @default(cuid())
  tenantId   String?
  tenant     Tenant?         @relation(fields: [tenantId], references: [id])
  // Business scope. A Business Owner's audit view filters on this column;
  // rows with a null customerId are platform-level events and are visible
  // to Platform Admins only.
  customerId String?
  customer   Customer?       @relation(fields: [customerId], references: [id])
  actorId    String?
  actor      User?           @relation(fields: [actorId], references: [id])
  actorIp    String?
  actorAgent String?
  action     ActivityAction
  resource   String?
  resourceId String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([tenantId])
  @@index([customerId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([tenantId, createdAt])
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Business the key acts on behalf of. A key can never read or write
  // outside it. Null only on pre-0009 keys, which are refused at auth time.
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdById String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  scopes      String[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([customerId])
  @@index([keyHash])
}

// ─── Invitations ─────────────────────────────────────────────────────────────

model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  email       String
  roleId      String?
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([token])
}

// ─── Saved Views ──────────────────────────────────────────────────────────────

model SavedView {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  name      String
  resource  String
  filters   Json
  columns   String[]
  sortField String?
  sortDir   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─── Platform Settings ───────────────────────────────────────────────────────

// Single-row table (id is pinned to "singleton"). Platform-wide feature
// switches owned by the Rem0te operator.
model PlatformSettings {
  id String @id @default("singleton")

  // MASTER switch for Quick Connect. OFF here means Quick Connect is
  // unavailable everywhere regardless of per-business or per-user settings.
  quickConnectEnabled Boolean @default(false)

  // Which Quick Connect client builds are offered. Only platforms with a
  // working build should be advertised on /quick.
  quickConnectWindows Boolean @default(true)
  quickConnectMacos   Boolean @default(false)
  quickConnectLinux   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Platform Security Config ────────────────────────────────────────────────

model PlatformSecurityConfig {
  id String @id @default(cuid())

  geoipBlockEnabled  Boolean  @default(false)
  ipAllowlistEnabled Boolean  @default(false)
  blockedCountries   String[]
  blockedIpRanges    String[]
  allowedIpRanges    String[]
  maxLoginAttempts   Int      @default(5)
  lockoutMinutes     Int      @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Tenant Policies ─────────────────────────────────────────────────────────

model TenantPolicy {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  resource String
  rules    Json
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}
