your-domain.example.com {
    # Uploaded branding. Served as inert files: a logo has no business running
    # script, and these are same-origin with the console.
    handle /uploads/* {
        root * /opt/reboot-remote
        header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
        header X-Content-Type-Options nosniff
        file_server
    }

    # RustDesk over 443. With allow-websocket=Y and api-server=https://<host>,
    # the client resolves a domain rendezvous/relay to wss://<host>/ws/id and
    # wss://<host>/ws/relay on 443 (hbb_common check_ws). Proxying them to
    # hbbs 21118 / hbbr 21119 lets endpoints behind 443-only egress connect
    # without opening 21115-21119.
    handle /ws/id {
        reverse_proxy localhost:21118
    }

    handle /ws/relay {
        reverse_proxy localhost:21119
    }

    # Web frontend
    handle /* {
        reverse_proxy localhost:3000
    }

    # API backend
    handle /api/* {
        reverse_proxy localhost:3001
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    encode gzip

    log {
        output file /var/log/caddy/reboot-remote.log
        format json
    }
}

# Approval signer (v0.26), on its OWN origin — never a path on the portal's.
# Same-origin with the portal, any script the portal served could drive the
# approval page; on a separate origin it cannot. Only the public listener is
# proxied: /approve/* only. The internal listener (127.0.0.1:3202) is the
# portal's and is never exposed. Set APPROVAL_ORIGIN=https://approve.your-domain.example.com
# and APPROVAL_RP_ID=approve.your-domain.example.com in /etc/rem0te-approver/signer.env.
