# Plain HTTP: redirect only, without announcing the server (Caddy still
# answers ACME HTTP-01 challenges on port 80 first). Add the approval
# signer's name here too if you enable it below.
http://your-domain.example.com {
    header -Server
    redir https://{host}{uri} permanent
}

your-domain.example.com {
    # Uploaded branding. Served as inert files: a logo has no business running
    # script, and these are same-origin with the console.
    handle /uploads/* {
        root * /opt/reboot-remote
        header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
        header X-Content-Type-Options nosniff
        file_server
    }

    # RustDesk over 443. With allow-websocket=Y and api-server=https://<host>,
    # the client resolves a domain rendezvous/relay to wss://<host>/ws/id and
    # wss://<host>/ws/relay on 443 (hbb_common check_ws). Proxying them to
    # hbbs 21118 / hbbr 21119 lets endpoints behind 443-only egress connect
    # without opening 21115-21119.
    handle /ws/id {
        reverse_proxy localhost:21118
    }

    handle /ws/relay {
        reverse_proxy localhost:21119
    }

    # The own MDM's device identity CA (0.84, docs/own-mdm.md M2, §93): step-ca,
    # `rem0te-mdm-ca`, on loopback only. iPhones and iPads fetch their
    # certificate here over ACME (device-attest-01, Apple attestation). Only
    # the one provisioner's path is proxied: no admin API, no other
    # provisioner, no /roots, no /sign. step-ca builds its ACME links from the
    # Host header, so they name this site. Its TLS is verified against the
    # device CA's root (copied here by deploy/mdm-ca/rem0te-mdm-ca-setup.sh's
    # instructions). Leave commented until the CA is installed.
    #handle /acme/rem0te-mdm/* {
    #    reverse_proxy https://127.0.0.1:9451 {
    #        # Caddy sends an https upstream its own address as Host, and
    #        # step-ca would then hand devices links to that loopback address.
    #        header_up Host {host}
    #        transport http {
    #            tls_trust_pool file /etc/caddy/rem0te-mdm-ca-root.crt
    #        }
    #    }
    #}

    # Web frontend
    handle /* {
        reverse_proxy localhost:3000
    }

    # API backend
    handle /api/* {
        reverse_proxy localhost:3001
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=()"
        -Server
    }

    encode gzip

    log {
        output file /var/log/caddy/reboot-remote.log
        format json
    }
}

# Approval signer (v0.26), on its OWN origin — never a path on the portal's.
# Same-origin with the portal, any script the portal served could drive the
# approval page; on a separate origin it cannot. Only the public listener is
# proxied: /approve/* only. The internal listener (127.0.0.1:3202) is the
# portal's and is never exposed. Set APPROVAL_ORIGIN=https://approve.your-domain.example.com
# and APPROVAL_RP_ID=approve.your-domain.example.com in /etc/rem0te-approver/signer.env.
