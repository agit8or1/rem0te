generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

enum MfaMethodType {
  TOTP
  RECOVERY_CODE
  WEBAUTHN
}

// The Rem0te authorization model has exactly three levels:
//
//   PLATFORM_ADMIN   the Rem0te operator — full access to every business
//   BUSINESS_OWNER   full administrative rights inside ONE business
//   BUSINESS_USER    only the capabilities the Business Owner grants
//                    (see Membership.capabilities)
//
// The values below BUSINESS_USER are legacy. Postgres cannot drop an enum
// value that historical rows may still reference, so they are retained as
// read-only tombstones. Migration 0008 remapped every Membership off them;
// nothing in the application assigns them any more.
enum RoleType {
  PLATFORM_ADMIN
  BUSINESS_OWNER
  BUSINESS_USER

  // ─ legacy, never assigned ─
  TENANT_OWNER
  TENANT_ADMIN
  TECHNICIAN
  BILLING_ADMIN
  READ_ONLY
  CUSTOMER
}

/// Who staged a RustDesk client update on a node (0.32).
enum UpdateRequestSource {
  MANUAL
  POLICY
}

/// A device group's kind (0.34): a hand-kept list, or a rule over the device list's filters.
enum EndpointGroupKind {
  STATIC
  RULE
}

enum EndpointStatus {
  ACTIVE
  OFFLINE
  ARCHIVED
  PENDING_ENROLLMENT
}

enum EnrollmentStatus {
  PENDING
  CLAIMED
  ACTIVE
  REVOKED
}

enum SessionStatus {
  PENDING
  LAUNCH_REQUESTED
  LAUNCHER_ACKNOWLEDGED
  CLIENT_OPENED
  SESSION_STARTED
  SESSION_COMPLETED
  FAILED
  CANCELED
  // No reliable evidence either way. Written by timeout cleanup for a launch
  // that never produced a confirming or failing signal. See session-state.ts.
  STATUS_UNKNOWN
}

enum NoteVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
}

