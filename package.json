{
  "name": "reboot-remote",
  "version": "0.13.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @reboot-remote/api dev & pnpm --filter @reboot-remote/web dev",
    "build": "pnpm --filter @reboot-remote/api build && pnpm --filter @reboot-remote/web build",
    "db:migrate": "pnpm --filter @reboot-remote/api exec prisma migrate deploy",
    "db:generate": "pnpm --filter @reboot-remote/api exec prisma generate",
    "db:seed": "pnpm --filter @reboot-remote/api exec prisma db seed",
    "db:studio": "pnpm --filter @reboot-remote/api exec prisma studio",
    "lint": "pnpm --filter @reboot-remote/api run lint && pnpm --filter @reboot-remote/web run lint",
    "typecheck": "pnpm --filter @reboot-remote/api exec tsc --noEmit && pnpm --filter @reboot-remote/web exec tsc --noEmit",
    "docs:api": "node scripts/gen-api-reference.mjs"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion": ">=5.0.9",
      "fast-uri": ">=3.1.1",
      "picomatch": ">=4.0.4",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=5.1.7",
      "postcss": ">=8.5.23",
      "file-type": ">=21.3.1",
      "path-to-regexp": ">=8.4.0",
      "lodash": ">=4.18.1",
      "multer": ">=2.2.0",
      "esbuild": ">=0.25.0 <0.27.3",
      "glob": ">=12.0.0",
      "flatted": ">=3.4.2",
      "qs": ">=6.15.2",
      "@babel/core": ">=7.29.6",
      "body-parser": ">=2.3.0",
      "sharp": ">=0.35.0",
      "ajv@>=7.0.0 <8.18.0": ">=8.18.0"
    }
  }
}
